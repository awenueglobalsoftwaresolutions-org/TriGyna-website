# TriGyna Backend API Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (STRICTLY MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/trigyna
MONGODB_DB_NAME=trigyna

# Client Application Origin (CORS Allowed Origins)
FRONTEND_ORIGIN=http://localhost:3000

# Cryptographic Secrets (Generate with `openssl rand -base64 32`)
SESSION_SECRET=your-secure-session-secret-here-at-least-32-chars
COOKIE_SECRET=your-secure-cookie-secret-here-at-least-32-chars
CSRF_SECRET=your-secure-csrf-secret-here-at-least-32-chars
JWT_SECRET=your-secure-jwt-signing-key-here-at-least-64-hex-chars

# External Integration Credentials (Production Staging / Live)
# Document Attachment Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=trigyna-documents

# Patient OTP & Notification SMS Delivery Adapter (Twilio / Kaleyra)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=TRIGYN

# Payment Gateway (Razorpay Official API & Payment Links)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# JWT Token Expiration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API Integration (Production / Staging)
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your-meta-cloud-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-registered-phone-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
META_WEBHOOK_VERIFY_TOKEN=your-configured-meta-webhook-verify-token
META_WEBHOOK_APP_SECRET=your-meta-app-secret-for-sha256-hmac
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-registered-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_API_VERSION=v21.0

# Transactional Email Delivery (Nodemailer / SMTP / SendGrid)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=care@trigyna.in
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM=care@trigyna.in
EMAIL_FROM_NAME="TriGyna Health & Wellness"
EMAIL_API_KEY=your-email-provider-api-key

# Push Notifications (Firebase Cloud Messaging / WebPush)
FCM_PROJECT_ID=your-firebase-project-id

# Partner CRM Lead Ingestion (Comma-separated authorized partner API keys)
PARTNER_API_KEYS=partner_key_1,partner_key_2

