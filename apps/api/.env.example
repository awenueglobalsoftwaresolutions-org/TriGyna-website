# TriGyna Backend API Environment Configuration Example
# Copy this file to apps/api/.env for server-side environment configuration.
# STRICT DEVSECOPS RULE: NEVER commit actual secrets, passwords, or database credentials.

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (STRICTLY MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/trigyna
DB_NAME=trigyna
MONGODB_DB_NAME=trigyna
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# Client Application Origins (CORS Allowed Origins)
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://127.0.0.1:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cryptographic Secrets (Minimum 64-character high-entropy string: `openssl rand -base64 48`)
SESSION_SECRET=your_secure_session_secret_at_least_64_characters_long
COOKIE_SECRET=your_secure_cookie_secret_at_least_64_characters_long
CSRF_SECRET=your_secure_csrf_secret_at_least_64_characters_long
JWT_SECRET=your_secure_jwt_secret_at_least_64_characters_long
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_at_least_64_characters_long
JWT_EXPIRES_IN=7d

# Initial Production Super Admin Provisioning (Used ONLY by seed:production-admin)
ADMIN_NAME=Sushil Kumar Kushwaha
ADMIN_EMAIL=Codewithsushil7236@gmail.com
ADMIN_PHONE=723689648
ADMIN_INITIAL_PASSWORD=your_secure_initial_super_admin_password

# External Integration Credentials (Production / Staging)
# Payment Gateway (Razorpay Backend Credentials)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Meta WhatsApp Cloud API Integration
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_registered_whatsapp_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_business_account_id
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
META_WEBHOOK_APP_SECRET=your_meta_webhook_app_secret

# Transactional Email Delivery (Resend API & SMTP)
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret_here
RESEND_FROM_EMAIL=care@trigyna.in
RESEND_FROM_NAME="TriGyna"
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=re_your_resend_smtp_password_here

# Document Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=trigyna-documents
