# TriGyna Backend API Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (STRICTLY MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/trigyna
MONGODB_DB_NAME=trigyna

# Client Application Origin (CORS Allowed Origins)
FRONTEND_ORIGIN=http://localhost:3000

# Cryptographic Secrets (Generate with `openssl rand -base64 32`)
SESSION_SECRET=your-secure-session-secret-here-at-least-32-chars
COOKIE_SECRET=your-secure-cookie-secret-here-at-least-32-chars
CSRF_SECRET=your-secure-csrf-secret-here-at-least-32-chars
JWT_SECRET=your-secure-jwt-signing-key-here-at-least-64-hex-chars

# External Integration Credentials (Production Staging / Live)
# Document Attachment Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=trigyna-documents

# Patient OTP & Notification SMS Delivery Adapter (Twilio / Kaleyra)
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=TRIGYN

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
