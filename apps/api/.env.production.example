# TriGyna Backend Production Environment Configuration Example
# Configure these environment variables in Railway / production server environment.
# NEVER commit the actual .env file or production secrets to Git.

# Server Environment
NODE_ENV=production
PORT=5000

# Database Configuration (STRICTLY MongoDB Atlas with SSL / ReplicaSet)
MONGODB_URI=mongodb+srv://production_app_user:your_secure_db_password_here@cluster0.mongodb.net/trigyna_production?retryWrites=true&w=majority
MONGODB_DB_NAME=trigyna_production

# Client Application Origin (Production Frontend Origin for CORS)
FRONTEND_ORIGIN=https://www.trigyna.com

# Cryptographic Secrets (Minimum 64-char high-entropy string: `openssl rand -base64 48`)
SESSION_SECRET=your_production_session_secret_at_least_64_characters_long
COOKIE_SECRET=your_production_cookie_secret_at_least_64_characters_long
CSRF_SECRET=your_production_csrf_secret_at_least_64_characters_long
JWT_SECRET=your_production_jwt_signing_key_at_least_64_hex_characters_long
JWT_EXPIRES_IN=7d

# External Integration Credentials (Production Live)
# Document Attachment Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-production-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-production-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=trigyna-production-documents

# Patient OTP & Notification SMS Delivery Adapter (Twilio / Kaleyra)
SMS_PROVIDER=mock
SMS_API_KEY=your-production-sms-api-key
SMS_SENDER_ID=TRIGYN

# Payment Gateway (Razorpay Live Production Credentials)
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_signing_secret

# Meta WhatsApp Cloud API Integration (Production Live)
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your-production-meta-cloud-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-production-whatsapp-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-production-whatsapp-business-account-id
META_WEBHOOK_VERIFY_TOKEN=your-production-meta-webhook-verify-token
META_WEBHOOK_APP_SECRET=your-production-meta-app-secret-for-sha256-hmac

# Transactional Email Delivery (SendGrid / Postmark / SMTP)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=your-production-email-provider-api-key
EMAIL_FROM_ADDRESS=care@trigyna.com
EMAIL_FROM_NAME="TriGyna Healthcare"

# Push Notifications (Firebase Cloud Messaging / WebPush)
FCM_PROJECT_ID=your-production-firebase-project-id

# Partner CRM Lead Ingestion (Comma-separated authorized partner API keys)
PARTNER_API_KEYS=your_partner_api_key_1,your_partner_api_key_2
