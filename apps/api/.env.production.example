# TriGyna Backend Production Environment Configuration
# Configure these environment variables in your production server environment / secret manager.
# NEVER commit the actual .env file or real secrets to Git.

# Server Environment
NODE_ENV=production
PORT=5000

# Database Configuration (STRICTLY MongoDB Atlas with SSL / ReplicaSet)
# Template: mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/trigyna?compressors=zlib&retryWrites=true&w=majority
DB_NAME=trigyna
MONGODB_DB_NAME=trigyna
MONGODB_MAX_POOL_SIZE=25
MONGODB_MIN_POOL_SIZE=5

# Client Application Origins (Production Frontend for CORS)
FRONTEND_URL=https://www.trigyna.in
FRONTEND_ORIGIN=https://www.trigyna.in
APP_URL=https://www.trigyna.in
BACKEND_URL=https://api.trigyna.in
CORS_ALLOWED_ORIGINS=https://www.trigyna.in,https://trigyna.in

# Cryptographic Secrets (Minimum 64-character high-entropy string: `openssl rand -base64 48`)
SESSION_SECRET=your_production_session_secret_at_least_64_characters_long
COOKIE_SECRET=your_production_cookie_secret_at_least_64_characters_long
CSRF_SECRET=your_production_csrf_secret_at_least_64_characters_long
JWT_SECRET=your_production_jwt_signing_key_at_least_64_characters_long
JWT_REFRESH_SECRET=your_production_jwt_refresh_key_at_least_64_characters_long
JWT_EXPIRES_IN=7d

# Canonical Super Admin Account Provisioning (Used ONLY by seed:production-admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@trigyna.in
ADMIN_PHONE=9876543210
ADMIN_INITIAL_PASSWORD=your_secure_initial_super_admin_password

# External Integration Credentials (Production Live)
# Payment Gateway (Razorpay Live Production Credentials)
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_signing_secret

# Meta WhatsApp Cloud API Integration (Production Live)
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your_production_meta_cloud_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_production_whatsapp_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_production_whatsapp_business_account_id
META_WEBHOOK_VERIFY_TOKEN=your_production_meta_webhook_verify_token
META_WEBHOOK_APP_SECRET=your_production_meta_app_secret

# Transactional Email Delivery (Production SMTP / Nodemailer)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=support@trigyna.in
EMAIL_PASSWORD=your_production_smtp_app_password
EMAIL_FROM_ADDRESS=support@trigyna.in
EMAIL_FROM_NAME="TriGyna Healthcare"

# Document Storage (Cloudflare R2 / S3 Compatible)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_production_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_production_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=trigyna-production-documents


# ==============================================================================
# Redis Distributed Infrastructure & Caching (Railway Production Service)
# ==============================================================================
# Railway internal private network configuration
REDIS_URL=redis://<REDIS_USER>:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_USERNAME=trigyna
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_TLS=false

REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=10

CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=trigyna

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=200
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_ENQUIRY_MAX=15
RATE_LIMIT_DOC_VERIFICATION_MAX=60
