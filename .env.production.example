# TriGyna Next.js Production Frontend Environment Variables Example
# Set these in your production hosting platform (e.g., Vercel Project Settings)

# Official Production Site URL (Canonical Domain)
NEXT_PUBLIC_SITE_URL=https://www.trigyna.in

# Canonical Backend Production API Endpoint (HTTPS only)
NEXT_PUBLIC_API_URL=https://api.trigyna.in/api/v1

# Razorpay Live Key ID (Client-side checkout only - Key Secret stays on backend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_live_key_id

# Clinic WhatsApp Contact (without leading + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919172772326

# Clinic Helpline Phone
NEXT_PUBLIC_CLINIC_PHONE=+919172772326
