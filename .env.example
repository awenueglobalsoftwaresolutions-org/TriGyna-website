# TriGyna Next.js Frontend Environment Configuration Example
# Copy this file to .env.local for local frontend development.
# IMPORTANT: Never place backend secrets or database credentials in frontend configuration.

# Public API Backend Endpoint
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api/v1

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay Key ID (Public Client-side checkout only - Key Secret stays on backend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key_id

# Clinic Public Helpline & WhatsApp Contact (Digits only without leading + for WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=919172772326
NEXT_PUBLIC_CLINIC_PHONE=+919172772326

# Optional: Enable 1-click test login buttons strictly in development mode only
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false

